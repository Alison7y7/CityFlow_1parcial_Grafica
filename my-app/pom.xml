<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- IDENTIFICACION DEL PROYECTO  -->
  <groupId>com.mycompany.app</groupId>
  <artifactId>my-app</artifactId>
  <packaging>jar</packaging>
  <version>1.0-SNAPSHOT</version>
  <name>my-app</name>
  <url>http://maven.apache.org</url>

   <!-- PROPIEDADES QUE SE UTILIZAN EN EL POM.XML  
       AQUI SE PUEDE DEFINIR LA VERSION DE JAVA, Y TAMBIEN EL LWJGL
   
   -->
   <properties>
     <!-- version de Java para compilar -->
    <maven.compiler.source>17</maven.compiler.source>
     <!-- version del bytecode para compilar -->
    <maven.compiler.target>17</maven.compiler.target>
    <!-- version de LWJGL -->
    <lwjgl.version>3.3.3</lwjgl.version>
    <!-- clase que contiene public static void main  -->
    <mainClass>com.graphics.App</mainClass>  

   </properties>
   
  <!-- BIBLIOTECAS QUE EL PROYECTO NECESITA PARA COMPILAR Y EJECUTAR  -->
  <dependencies>
    <dependency>
    <!-- junit es una biblioteca para escribir pruebas unitarias  -->
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>3.8.1</version>
      <scope>test</scope>
    </dependency>
<!-- LWJGL: Son los binding de java para OpenGL Y GLFW
     Agregaremos 3 modulos principales.- 
     LWJGL: es el nucleo para la carga de la biblioteca nativa de openGL
     LWJGL-GLFW: es para crear ventanas, teclado, raton y eventos de entrada
     LWJGL-OPENGL: son las llamadas a openGL para dibujar en pantalla
   -->

    <!-- LWJGL: es el nucleo para la carga de la biblioteca nativa de openGL -->

    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl</artifactId>
      <version>${lwjgl.version}</version>
    </dependency>

    <!-- LWJGL-GLFW: es para crear ventanas, teclado, raton y eventos de entrada -->

    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl-glfw</artifactId>
      <version>${lwjgl.version}</version>
    </dependency>
   
    <!-- LWJGL-OPENGL: son las llamadas a openGL para dibujar en pantalla -->

    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl-opengl</artifactId>
      <version>${lwjgl.version}</version>
    </dependency>

  </dependencies>

  <!-- BUILD: como compilar y que plugins usar -->

    <build>
      <plugins>

      <!-- Aqui forzamos JAVA 17 para que el compilador use esa version
           aunque en el sistema haya otra.
       -->

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <source>17</source>
            <target>17</target>
            <release>17</release>       
          </configuration>
        </plugin>

        <!-- exen-maven-plugin: permite ejecutar la aplicación 
        con "mvn exec:exec"  -->
        
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.1.0</version>
          <configuration>
            <executable>java</executable>
            <arguments>
            <!-- GLWJ exige el hilo principal  
                 sea el primero  -->
              <argument>-XstartOnFirstThread</argument>
              <argument>-classpath</argument>
              <argument>${mainClass}</argument>
            </arguments>   
          </configuration>
        </plugin>

      </plugins>

    </build>
</project>
